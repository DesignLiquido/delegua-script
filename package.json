{
  "name": "delegua-script",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild fontes/delegua-script.ts --bundle --platform=browser --format=iife --target=es2019 --global-name=DeleguaScript --outfile=dist/delegua-script.js",
    "build:min": "esbuild fontes/delegua-script.ts --bundle --platform=browser --format=iife --target=es2019 --global-name=DeleguaScript --minify --outfile=dist/delegua-script.min.js",
    "watch": "esbuild fontes/delegua-script.ts --bundle --platform=browser --format=iife --target=es2019 --global-name=DeleguaScript --outfile=dist/delegua-script.js --watch",
    "exemplo": "yarn build && http-server . -p 8080 -c-1 -o /index.html",
    "testes": "jest --runInBand",
    "testes:watch": "jest --watch"
  },
  "devDependencies": {
    "@designliquido/delegua": "^1.18.4",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.0",
    "http-server": "^14.1.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
