{
  "name": "@designliquido/delegua-script",
  "version": "0.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "empacotar": "esbuild fontes/delegua-script.ts --bundle --platform=browser --format=iife --target=es2019 --global-name=DeleguaScript --outfile=dist/delegua-script.js",
    "empacotar:min": "esbuild fontes/delegua-script.ts --bundle --platform=browser --format=iife --target=es2019 --global-name=DeleguaScript --minify --outfile=dist/delegua-script.min.js",
    "watch": "esbuild fontes/delegua-script.ts --bundle --platform=browser --format=iife --target=es2019 --global-name=DeleguaScript --outfile=dist/delegua-script.js --watch",
    "continuo": "yarn empacotar && http-server . -p 8080 -c-1 -o /index.html",
    "publicar-npm": "npm publish ./dist --access public",
    "testes": "jest --runInBand",
    "testes:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesignLiquido/delegua-script.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@designliquido/delegua": "^1.18.4",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.0",
    "http-server": "^14.1.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
